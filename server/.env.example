# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# Porta local da API (em hospedagens como o Render, a porta vem pronta em PORT)
PORT=3000

# Supabase > Project Settings > Database > Connection string > "Session pooler"
DATABASE_URL=postgresql://postgres.xxxxxxxx:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Use "false" só se o seu Postgres local não tiver SSL
DATABASE_SSL=true

# Supabase > Project Settings > API
SUPABASE_URL=https://supabase.com/dashboard/project/athrheeiydhgdmuzyfht/settings/api-keys
SUPABASE_ANON_KEY=sb_publishable_fSOWOL9ydWIQH5RA8XfEJA_Nt9w4TbH

# Endereços do front-end autorizados a chamar a API, separados por vírgula
CORS_ORIGIN=http://localhost:5173

# Opcional: usado só pelo "npm run seed" (id do usuário, em Supabase > Authentication > Users)
# SEED_USUARIO_ID=00000000-0000-0000-0000-000000000000
